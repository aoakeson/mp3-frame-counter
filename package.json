{
  "name": "mp3-frame-counter",
  "version": "1.0.0",
  "description": "Counts the frames in an MPEG-1 Layer III (MP3) file.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && tsx src/server.ts",
    "build": "vite build",
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite",
    "check": "biome ci . && tsc --noEmit && tsc --noEmit -p web",
    "fix": "biome check --write .",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
