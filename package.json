{
  "name": "mp3-frame-counter",
  "version": "1.0.0",
  "description": "Counts the frames in an MPEG-1 Layer III (MP3) file.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "check": "biome ci . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
